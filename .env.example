RADAR_ENV=development
RADAR_VERSION=1.0.0
RADAR_ADDR=:8080
RADAR_LOG_LEVEL=info

# Rate limiting
RADAR_RATE_LIMIT=20
RADAR_RATE_BURST=40

# Agent auth — comma-separated bearer tokens.
# Leave EMPTY to run in dev mode (no auth required).
RADAR_AGENT_TOKENS=

# Tool sandboxing
RADAR_MAX_GREP_FILE_MB=10
RADAR_MAX_GREP_MATCHES=500
RADAR_SANDBOX_TIMEOUT_SEC=5

# Distributed tracing
RADAR_SERVICE_NAME=radar
